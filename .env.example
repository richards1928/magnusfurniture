# ==============================================================================
# MAGNUS OFFICE FURNITURE — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Note: In Vite, only variables prefixed with VITE_ are exposed to the client.
# NEVER put database passwords, service-role keys, or secret tokens in this file!
# ==============================================================================

# 1. Supabase Project Configuration (Obtain from your Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Local Development Fallback Credentials (Optional, only active when running 'npm run dev' without Supabase)
# Copy these to .env.local to test admin dashboard locally without internet/Supabase:
# VITE_DEV_ADMIN_EMAIL=admin@magnusfurniture.com
# VITE_DEV_ADMIN_PASSWORD=your-secure-dev-password

